# The Spark server fork's visible name and theme color.
APP_NAME=Spark
THEME_COLOR=#241046
# Spark's own push relay (repo Joloxx9/spark-push-relay) and the Apple topic
# (bundle ID) of the Spark apps. The relay hands the official Silo app's pushes
# on to Silo's relay, so the server accepts both topics.
PUSH_RELAY_URL=https://push.atlaslab.uk
APNS_TOPIC=com.joloxx9.spark
